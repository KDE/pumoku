#: contents/ui/Import.qml:13
#, kde-format
msgctxt "@title:window"
msgid "Import Sudoku"
msgstr "Импорт судоку"

#: contents/ui/Import.qml:37
#, kde-format
msgctxt "Please use UTF character EN DASH (U+2013) for number range"
msgid ""
"Enter or paste a string of 81 characters. 1–9 for given cells, 0 or any "
"single non-numeric character except space will do for blanks cells. PuMoKu "
"will check that the Sudoku is solvable and calculate the level.\n"
"\n"
"Line breaks and spaces are silently removed, so that you can enter one or "
"more rows per-line with some optional whitespace."
msgstr ""
"Введите или вставьте строку из 81 символа: 1–9 — для заданных ячеек, 0 или "
"любой одиночный нецифровой символ, кроме пробела, — для пустых. PuMoKu "
"проверит, имеет ли судоку решение, и определит уровень.\n"
"\n"
"Переносы строк и пробелы удаляются без предупреждения, поэтому можно вводить "
"по одному или нескольку рядов судоку на строку, добавляя при желании пробелы."

